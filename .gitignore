# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing credentials — NEVER commit
android/key.properties
*.keystore
*.jks

# Model files (large, downloaded on-device)
*.gguf

# Agent temp files
.tmp/

# Generated, and only meaningful as a set — the index, the passage vectors and
# the packed tokenizer must come from one run of one command:
#   python3 -m survive_rag pack --tokenizer <embeddinggemma tokenizer.json>
# A build without them still works; retrieval falls back to runtime chunking
# and the two lexical legs. The Dart parity tests skip rather than fail, so a
# green suite on a fresh clone does not mean they ran.
assets/index/
